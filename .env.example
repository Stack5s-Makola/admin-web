# Backend origin. The client appends /api itself.
# Local NestJS:  http://localhost:3000
# Render:        https://<service>.onrender.com
VITE_API_BASE_URL=

# DEV ONLY: sign in as a fake admin so the screens can be clicked through
# before the backend exists. Ignored in production builds.
VITE_DEV_FAKE_AUTH=false
